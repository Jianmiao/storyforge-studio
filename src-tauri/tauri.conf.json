{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryForge Studio",
  "version": "0.1.0",
  "identifier": "com.storyforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StoryForge Studio",
        "width": 1680,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  }
}
